{
  "name": "electron-quasar-file-explorer-v2",
  "version": "3.0.2",
  "private": true,
  "description": "Explore your file system",
  "author": "Jeff Galbraith <galbraith64@gmail.com>",
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules src-electron/node_modules dist .quasar",
    "dev": "node scripts/dev-electron.mjs",
    "build": "quasar build -m electron",
    "build:ci": "quasar build -m electron --publish never",
    "electron:install": "pnpm --dir src-electron install",
    "lint": "oxlint --ignore-path .oxlintignore .",
    "lint:fix": "oxlint --ignore-path .oxlintignore --fix .",
    "format": "oxfmt --ignore-path .oxfmtignore .",
    "format:check": "oxfmt --check --ignore-path .oxfmtignore .",
    "typecheck": "vue-tsc --project tsconfig.vue-tsc.json --noEmit",
    "test": "echo \"No test specified\" && exit 0",
    "verify:fast": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:build": "pnpm --dir src-electron install --frozen-lockfile && pnpm build:ci",
    "check:all": "pnpm verify",
    "verify": "pnpm verify:fast && pnpm verify:build",
    "deep": "ncu --configFilePath . --packageFile '{package.json,src-electron/package.json}'",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "2.0.0",
    "pretty-bytes": "^7.1.0",
    "quasar": "2.19.3",
    "vue": "3.5.35",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@quasar/app-vite": "3.0.0-beta.39",
    "@types/node": "^25.9.2",
    "autoprefixer": "^10.5.0",
    "npm-check-updates": "^22.2.3",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "typescript": "~6.0.3",
    "vite-plugin-checker": "^0.14.1",
    "vue-tsc": "^3.3.3"
  },
  "engines": {
    "node": ">=24.14.1",
    "pnpm": ">=11.5.0"
  },
  "packageManager": "pnpm@11.5.2",
  "productName": "File Explorer"
}
